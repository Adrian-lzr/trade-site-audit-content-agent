# Select one backend database for the API and Worker.
#
# Quick-start SQLite: comment out DATABASE_URL below. The application then
# defaults to sqlite:///./backend.db and does not require Docker.
#
# Local PostgreSQL used by docker-compose.yml:
POSTGRES_DB=trade_visibility
POSTGRES_USER=trade_visibility
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5434

# Backend settings (backend/config.py)
# DATABASE_URL=postgresql+psycopg://trade_visibility:change-me-local@127.0.0.1:5434/trade_visibility
CRAWLER_TIMEOUT=10
CRAWLER_MAX_REDIRECTS=5
FIXTURE_PORT=8765
ALLOW_LOOPBACK=false
# `demo` keeps anonymous local UI flows; use `required` behind a real identity gateway.
LOCAL_AUTH_MODE=demo
# Identity mode: demo/test permit local fixture actors; production requires a
# verified Bearer JWT with the exact issuer, audience, and one JWKS source below.
AUTH_MODE=demo
# OIDC_ISSUER=https://issuer.example.com/
# OIDC_AUDIENCE=trade-visibility
# OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# OIDC_JWKS_JSON=
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_CLOCK_SKEW_SECONDS=30

# Optional Phase 4 local Git review target. When unset, publication is recorded
# as not_configured and no external write is attempted.
# GIT_PUBLISH_REPOSITORY=C:\path\to\isolated\git-repository
# GIT_PUBLISH_TARGET=demo

# Optional OpenAI-compatible content drafting. Leave unset for the deterministic local fixture.
# MODEL_GATEWAY_BASE_URL=https://api.example/v1
# MODEL_GATEWAY_API_KEY=
# MODEL_GATEWAY_MODEL=your-model-name
# MODEL_GATEWAY_TIMEOUT_SECONDS=30
# MODEL_GATEWAY_MAX_TOKENS=2048

# Optional Phase 5 visibility provider. Without both URL and key the provider
# returns `unavailable`; it never treats a normal model response as a search
# observation. Use a separately authorized structured endpoint.
# VISIBILITY_PROVIDER_URL=https://api.example/visibility
# VISIBILITY_PROVIDER_API_KEY=
# VISIBILITY_PROVIDER_MODEL=your-visibility-model
# VISIBILITY_PROVIDER_TIMEOUT=20
# VISIBILITY_INPUT_PRICE_PER_1K=0
# VISIBILITY_OUTPUT_PRICE_PER_1K=0
# Optional runtime governance. Zero disables the corresponding budget cap.
# VISIBILITY_MAX_RUN_BUDGET_USD=0
# VISIBILITY_DAILY_BUDGET_USD=0
# Raw provider bodies are bounded and removed after this many days; parsed
# answers, citations, status, request IDs and cost metadata remain available.
# VISIBILITY_RAW_RETENTION_DAYS=30
# VISIBILITY_RAW_MAX_BYTES=200000

# Frontend can use same-origin Vite proxy by leaving this empty.
VITE_API_BASE_URL=
# Optional local fixture actor for demo/test UI checks. Never use this as a
# production credential; production browsers must send a verified Bearer token.
# VITE_LOCAL_USER=demo-user
