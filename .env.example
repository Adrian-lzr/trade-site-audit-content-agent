# Select one backend database for the API and Worker.
#
# Quick-start SQLite: comment out DATABASE_URL below. The application then
# defaults to sqlite:///./backend.db and does not require Docker.
#
# Local PostgreSQL used by docker-compose.yml:
POSTGRES_DB=trade_visibility
POSTGRES_USER=trade_visibility
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

# Backend settings (backend/config.py)
# DATABASE_URL=postgresql+psycopg://trade_visibility:change-me-local@127.0.0.1:5432/trade_visibility
CRAWLER_TIMEOUT=10
CRAWLER_MAX_REDIRECTS=5
ALLOW_LOOPBACK=false

# Optional OpenAI-compatible content drafting. Leave unset for the deterministic local fixture.
# MODEL_GATEWAY_BASE_URL=https://api.example/v1
# MODEL_GATEWAY_API_KEY=
# MODEL_GATEWAY_MODEL=your-model-name
# MODEL_GATEWAY_TIMEOUT_SECONDS=30
# MODEL_GATEWAY_MAX_TOKENS=2048

# Frontend can use same-origin Vite proxy by leaving this empty.
VITE_API_BASE_URL=
